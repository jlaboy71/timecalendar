# ============================================
# TJM Time Calendar - Environment Configuration
# ============================================
# Copy this file to .env and update values
# NEVER commit .env to version control
# ============================================

# ============================================
# Database Configuration
# ============================================
# SQLite database file in project root (simpler deployment)
DATABASE_URL=sqlite:///tjm_calendar.db

# Alternative: PostgreSQL (for production with higher concurrency needs)
# DATABASE_URL=postgresql://user:password@localhost/ptodb

# ============================================
# Security (REQUIRED)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# ============================================
# Environment Settings
# ============================================
# Options: development, production
ENVIRONMENT=development

# Debug mode - set to False in production
DEBUG=True

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Anthropic API (Optional)
# ============================================
# For Handbook AI Assistant - managers/admins only
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Email Configuration (Optional)
# ============================================
# Enable email notifications
EMAIL_ENABLED=false

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=STARTTLS

# SMTP Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From Address
EMAIL_FROM=noreply@yourcompany.com
EMAIL_FROM_NAME=TJM Time Calendar

# ============================================
# Server Settings (Optional)
# ============================================
# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
TJM_HOST=0.0.0.0

# Port to run on
TJM_PORT=8080

# ============================================
# HTTPS/SSL Configuration (Optional)
# ============================================
# Generate self-signed certificate:
#   python scripts/generate_ssl_cert.py
#
# Or use your own CA-signed certificate
# TJM_SSL_CERT=certs/server.crt
# TJM_SSL_KEY=certs/server.key

# ============================================
# Production Checklist
# ============================================
# Before deploying to production:
# 1. Generate a new SECRET_KEY (use command above)
# 2. Set ENVIRONMENT=production
# 3. Set DEBUG=False
# 4. Configure HTTPS (uncomment TJM_SSL_CERT and TJM_SSL_KEY above)
# 5. Rotate any exposed API keys
