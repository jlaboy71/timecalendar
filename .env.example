# Database Configuration
# SQLite database file in project root (simpler deployment)
DATABASE_URL=sqlite:///tjm_calendar.db

# Alternative: PostgreSQL (for production with higher concurrency needs)
# DATABASE_URL=postgresql://user:password@localhost/ptodb

# Security
SECRET_KEY=your-secret-key-here

# Environment
ENVIRONMENT=development

# Optional: Additional configuration
DEBUG=True
LOG_LEVEL=INFO

# Anthropic API Key (for Handbook AI Assistant - managers/admins only)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email Configuration (optional - for notifications)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourcompany.com
